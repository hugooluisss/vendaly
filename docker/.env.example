# Optional: set only when serving the web app under a URL path prefix behind a reverse proxy.
# Leave unset for normal root-path serving.
# WEB_SERVE_FLAGS='--configuration gateway --serve-path /some-prefix/'

# Optional: match the API container user to your host user for writable bind mounts.
# Set these in docker/.env using the output of `id -u` and `id -g`.
# LOCAL_UID=1000
# LOCAL_GID=1000
